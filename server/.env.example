# Shared secret. Put the same value into the app's admin settings.
PRINT_API_TOKEN=change-me

# CUPS queue name as shown by `lpstat -p`.
PRINT_QUEUE=Printer

# Optional: only accept requests from this Nextcloud server.
# Comma-separated addresses; leave empty to accept any client with the token.
PRINT_API_ALLOWED=192.168.1.10

# CUPS server used by `lp`. Leave empty to use a CUPS on the same host.
CUPS_SERVER=192.168.1.20:631
